# Duffel sandbox token — get one free at https://app.duffel.com/join
# Must start with duffel_test_ for sandbox mode
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to true to use local fixture data instead of calling real APIs
# (Duffel, Open-Meteo, Groq) — no network calls, no sandbox rate limit usage.
USE_MOCK_DATA=false

# Postgres (matches docker-compose.yml's mapped port)
DATABASE_URL=postgresql://tripweaver:tripweaver@localhost:5435/tripweaver

# Which backend the CrewAI researcher/planner agents reason with:
# ollama (default, local-first) | groq | gemini
LLM_PROVIDER=ollama
# Optional: run the planner on a different provider than the researcher,
# to split load across two separate quotas. Empty = same as LLM_PROVIDER.
PLANNER_LLM_PROVIDER=

# Optional per-task-category overrides for the research crew (flight, car,
# hotel, weather/visa/ground-transport "context", and the exact-copy
# "formatter" step each run as their own Agent now). Each falls back to
# LLM_PROVIDER when empty. Use this to spread calls across multiple
# providers' free-tier quotas, and to put money-committing/hallucination-
# sensitive tasks (flight, car, formatter) on a stronger hosted model while
# lower-stakes tasks (hotel, context) run on a cheaper/local one.
RESEARCH_FLIGHT_LLM_PROVIDER=
RESEARCH_CAR_LLM_PROVIDER=
RESEARCH_HOTEL_LLM_PROVIDER=
RESEARCH_CONTEXT_LLM_PROVIDER=
RESEARCH_FORMATTER_LLM_PROVIDER=

# Used when LLM_PROVIDER=ollama. Requires a running local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Used when LLM_PROVIDER=groq (agent reasoning) — get a free key from
# https://console.groq.com/keys. Also used, independently of LLM_PROVIDER,
# by check_visa_requirements() (app/tools/visa.py), which always calls Groq
# directly with its own hardcoded model regardless of this setting.
GROQ_API_KEY=
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=gemini — get a free key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Used by estimate_ground_transport() (app/tools/ground_transport.py) —
# deliberately rough, global placeholder defaults, not tuned to any
# specific city/country, since the tool only ever returns a disclaimed
# estimate. Override if you want figures more realistic for a specific market.
GROUND_TRANSPORT_RATE_PER_KM_USD=0.6
GROUND_TRANSPORT_MIN_FARE_USD=3.0
