# Duffel sandbox token — get one free at https://app.duffel.com/join
# Must start with duffel_test_ for sandbox mode
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Postgres (used from Phase 5 onward)
DATABASE_URL=postgresql://tripweaver:tripweaver@localhost:5432/tripweaver

# LLM provider for CrewAI agents (Phase 3 onward)
# Point at local Ollama by default
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional: use a hosted model instead of Ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
